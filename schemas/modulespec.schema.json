{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seedle.local/schemas/modulespec.schema.json",
  "title": "Seedle ModuleSpec",
  "type": "object",
  "required": ["modulespec", "identity", "capabilities", "service"],
  "additionalProperties": false,
  "properties": {
    "modulespec": { "const": "0.1" },
    "identity": {
      "type": "object",
      "required": ["type", "model", "version"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "source": { "type": "string" }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "standard"],
        "additionalProperties": true,
        "properties": {
          "kind": {
            "enum": ["power", "data", "fluid", "air", "mechanical", "optical"]
          },
          "standard": { "type": "string", "minLength": 1 }
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["actor", "service_face", "approach", "isolation", "remove", "install", "verify"],
      "additionalProperties": true,
      "properties": {
        "actor": { "type": "string", "minLength": 1 },
        "service_face": { "type": "string", "minLength": 1 },
        "approach": { "type": "string", "minLength": 1 },
        "clearance_mm": { "type": "object" },
        "mass_g": { "type": "number", "minimum": 0 },
        "isolation": { "type": "array", "items": { "type": "string" } },
        "remove": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "install": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "verify": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": true
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
