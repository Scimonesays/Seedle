{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seedle.local/schemas/growspec.schema.json",
  "title": "Seedle GrowSpec",
  "type": "object",
  "required": ["growspec", "identity", "crop", "stages", "harvest"],
  "additionalProperties": false,
  "properties": {
    "growspec": { "const": "0.1" },
    "identity": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "version": { "type": "string", "minLength": 1 },
        "evidence_level": {
          "enum": ["draft", "experimental", "community-tested", "verified", "recommended"]
        }
      }
    },
    "crop": {
      "type": "object",
      "required": ["common_name"],
      "additionalProperties": true,
      "properties": {
        "common_name": { "type": "string", "minLength": 1 },
        "scientific_name": { "type": "string" },
        "cultivar": { "type": "string" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": true
    },
    "environment": {
      "type": "object",
      "additionalProperties": true
    },
    "lighting": {
      "type": "object",
      "additionalProperties": true
    },
    "root_zone": {
      "type": "object",
      "additionalProperties": true
    },
    "nutrition": {
      "type": "object",
      "additionalProperties": true
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "enter": { "type": "object" },
          "exit": { "type": "object" },
          "targets": { "type": "object" }
        }
      }
    },
    "interventions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "requires", "procedure", "on_failure"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "once": { "type": "boolean" },
          "requires": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "procedure": { "type": "object" },
          "verify": { "type": "array" },
          "on_failure": { "type": "string", "minLength": 1 }
        }
      }
    },
    "harvest": {
      "type": "object",
      "required": ["requires", "readiness", "procedure"],
      "additionalProperties": true,
      "properties": {
        "requires": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "readiness": { "type": "object" },
        "procedure": { "type": "object" }
      }
    },
    "turnover": {
      "type": "object",
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
